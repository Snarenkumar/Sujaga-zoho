<%- include('partials/head', { page: 'architecture', title: 'Architecture' }) %>
<%- include('partials/nav', { role: typeof role !== 'undefined' ? role : 'guest', page: 'architecture' }) %>

<div class="page-header">
  <div>
    <h1>System Architecture</h1>
    <span class="zoho-label"><i data-lucide="network"></i> Data Flow</span>
  </div>
</div>

<div class="panel" style="max-width:900px; margin: 2rem auto; position:relative; overflow:hidden;">
  <div style="padding: 1.5rem; border: 2px dashed rgba(255,255,255,0.1); border-radius: 12px; margin-bottom: 2rem; position: relative;">
    <div style="position: absolute; top: -12px; left: 24px; background: var(--bg-panel); padding: 0 10px; color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-transform: uppercase;">Security Layer</div>
    <div style="display:flex; justify-content:space-around; align-items:center;">
      <div style="display:flex; align-items:center; gap:0.5rem;"><i data-lucide="shield-check" style="color:var(--zoho-blue)"></i> Zoho Vault</div>
      <div style="display:flex; align-items:center; gap:0.5rem;"><i data-lucide="users" style="color:var(--zoho-blue)"></i> Zoho Directory</div>
    </div>
  </div>

  <div style="display:flex; flex-direction:column; gap: 1rem; align-items:center;">
    <!-- Step 1 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2rem; border-radius:8px; border:1px solid var(--border); min-width:300px;">
        <i data-lucide="table" style="color:#10B981; margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Sheet & Creator</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Data Entry & Storage</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--text-muted);"></i>
    </div>
    
    <!-- Step 2 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2rem; border-radius:8px; border:1px solid var(--border); min-width:300px;">
        <i data-lucide="zap" style="color:#FBBF24; margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Flow</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Workflow Automation</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--text-muted);"></i>
    </div>

    <!-- Step 3 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2rem; border-radius:8px; border:1px solid var(--border); min-width:300px;">
        <i data-lucide="filter" style="color:var(--zoho-blue); margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho DataPrep</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Data Cleansing</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--text-muted);"></i>
    </div>

    <!-- Step 4 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2rem; border-radius:8px; border:1px solid var(--zoho-red); min-width:300px; box-shadow:0 0 15px rgba(244,63,94,0.15);">
        <i data-lucide="database" style="color:var(--zoho-red); margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Catalyst</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Serverless Pattern Matching Engine</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--text-muted);"></i>
    </div>

    <!-- Step 5 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2rem; border-radius:8px; border:1px solid var(--border); min-width:300px;">
        <i data-lucide="pie-chart" style="color:#8b5cf6; margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Analytics & Zia</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Dashboard & NLP Chat</p>
      </div>
    </div>
  </div>

  <div style="margin-top: 3rem; text-align:center; padding-top:1.5rem; border-top:1px solid var(--border);">
    <p class="muted" style="font-size:0.85rem;"><strong>Prototype note:</strong> Catalyst's matching/scoring logic is simulated with seeded test data for this demo — the data flow and Zoho architecture shown are the real production design.</p>
  </div>
</div>

<%- include('partials/footer') %>
