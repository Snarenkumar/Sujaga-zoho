<%- include('partials/head', { page: 'architecture', title: 'Architecture' }) %>
<%- include('partials/nav', { role: typeof role !== 'undefined' ? role : 'guest', page: 'architecture' }) %>

<div class="page-header">
  <div>
    <h1>
      <span class="en">System Architecture</span>
      <span class="kn">ವ್ಯವಸ್ಥೆಯ ವಾಸ್ತುಶಿಲ್ಪ</span>
    </h1>
    <span class="zoho-label"><i data-lucide="network"></i> Data Flow</span>
  </div>
</div>

<div class="panel" style="max-width:1100px; margin: 1.5rem auto; padding: 2rem;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <h2>
      <span class="en">Sujaga Enterprise Architecture Overview</span>
      <span class="kn">ಸುಜಾಗ ಎಂಟರ್‌ಪ್ರೈಸ್ ವಾಸ್ತುಶಿಲ್ಪ ಅವಲೋಕನ</span>
    </h2>
    <p class="muted">
      <span class="en">Live deployed on <strong>Zoho Catalyst AppSail</strong> with 2-Way <strong>Zoho Sheet API</strong> Integration &amp; Private Cloud Sovereignty</span>
      <span class="kn"><strong>Zoho Catalyst AppSail</strong> ಮೇಲೆ ಬಲವಂತವಾಗಿ ನಿಯೋಜಿಸಲಾಗಿದೆ — 2-ವೇ <strong>Zoho Sheet API</strong> ಸಂಯೋಜನೆ &amp; ಖಾಸಗಿ ಕ್ಲೌಡ್ ಸಾರ್ವಭೌಮತೆ</span>
    </p>
  </div>

  <!-- Security & Directory Banner -->
  <div style="padding: 1.25rem 2rem; border: 2px dashed rgba(56, 189, 248, 0.3); background: rgba(56, 189, 248, 0.03); border-radius: 12px; margin-bottom: 2.5rem; display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display:flex; align-items:center; gap:0.6rem; font-weight:600;"><i data-lucide="shield-check" style="color:var(--zoho-blue); width:24px; height:24px;"></i> Zoho Vault (Secret Management)</div>
    <div style="display:flex; align-items:center; gap:0.6rem; font-weight:600;"><i data-lucide="users" style="color:#A855F7; width:24px; height:24px;"></i> Zoho Directory (Role-Based Access & Audit Log)</div>
    <div style="display:flex; align-items:center; gap:0.6rem; font-weight:600;"><i data-lucide="lock" style="color:#22C55E; width:24px; height:24px;"></i> Zero Third-Party AI Data Leaks</div>
  </div>

  <!-- Interactive Grid Diagrams -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    
    <!-- User Flow Card -->
    <div style="background: rgba(16, 22, 35, 0.7); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px;">
      <h3 style="display: flex; align-items: center; gap: 8px; color: #38BDF8; font-size: 1.1rem; margin-bottom: 1rem;">
        <i data-lucide="user-check"></i> Personas & User Flow
      </h3>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem;">
        <li style="background: rgba(255,255,255,0.03); padding: 0.75rem; border-radius: 6px; border-left: 3px solid #22C55E;">
          <strong>Data Entry Officer:</strong> Registers FIRs $\rightarrow$ Triggers live Zoho Sheet write & instant MO cross-district checks.
        </li>
        <li style="background: rgba(255,255,255,0.03); padding: 0.75rem; border-radius: 6px; border-left: 3px solid #38BDF8;">
          <strong>Investigator:</strong> Queries Zia Assistant in English/Kannada $\rightarrow$ Inspects Explainable Evidence Trails & Decaying Criminal Graphs.
        </li>
        <li style="background: rgba(255,255,255,0.03); padding: 0.75rem; border-radius: 6px; border-left: 3px solid #F43F5E;">
          <strong>Supervisor:</strong> Monitors Command Center $\rightarrow$ Analyzes Hotspots, Socio-Demographic Correlations, and System Audit Logs.
        </li>
      </ul>
    </div>

    <!-- Multi-Layer Stack Card -->
    <div style="background: rgba(16, 22, 35, 0.7); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px;">
      <h3 style="display: flex; align-items: center; gap: 8px; color: #F43F5E; font-size: 1.1rem; margin-bottom: 1rem;">
        <i data-lucide="layers"></i> Layered Technical Stack
      </h3>
      <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.85rem;">
        <div style="display:flex; justify-content:space-between; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px;">
          <span style="color:#94a3b8;">Frontend UI:</span>
          <strong>EJS, Vanilla JS (ES6+), Modern CSS</strong>
        </div>
        <div style="display:flex; justify-content:space-between; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px;">
          <span style="color:#94a3b8;">Runtime Server:</span>
          <strong>Node.js 24 + Express on Catalyst AppSail</strong>
        </div>
        <div style="display:flex; justify-content:space-between; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px;">
          <span style="color:#94a3b8;">Storage & Sync:</span>
          <strong>Zoho Sheet API v2 + Live In-Memory Cache</strong>
        </div>
        <div style="display:flex; justify-content:space-between; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px;">
          <span style="color:#94a3b8;">Visual Engines:</span>
          <strong>Chart.js, Leaflet, vis-network, jsPDF</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- End-to-End Pipeline Pipeline Nodes -->
  <h3 style="text-align: center; margin-bottom: 1.5rem; font-size: 1.2rem;">End-to-End Data Pipeline Architecture</h3>
  <div style="display:flex; flex-direction:column; gap: 1rem; align-items:center; margin-bottom: 3rem;">
    <!-- Step 1 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2.5rem; border-radius:10px; border:1px solid #10B981; min-width:340px;">
        <i data-lucide="file-spreadsheet" style="color:#10B981; margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Sheet & Data Entry</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Real-time bi-directional record creation & REST sync</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--zoho-blue);"></i>
    </div>

    <!-- Step 2 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2.5rem; border-radius:10px; border:1px solid #FBBF24; min-width:340px;">
        <i data-lucide="zap" style="color:#FBBF24; margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Flow Automation</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Automated cross-department webhook notifications</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--zoho-blue);"></i>
    </div>

    <!-- Step 3 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2.5rem; border-radius:10px; border:1px solid var(--zoho-red); min-width:340px; box-shadow:0 0 20px rgba(244,63,94,0.2);">
        <i data-lucide="cpu" style="color:var(--zoho-red); margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Catalyst AppSail Engine</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Semantic MO Fingerprinting, Haversine Geospatial & Decay Graph</p>
      </div>
      <i data-lucide="arrow-down" style="color:var(--zoho-blue);"></i>
    </div>

    <!-- Step 4 -->
    <div style="display:flex; align-items:center; gap:1rem; flex-direction:column; text-align:center;">
      <div style="background:rgba(255,255,255,0.05); padding:1rem 2.5rem; border-radius:10px; border:1px solid #8b5cf6; min-width:340px;">
        <i data-lucide="bot" style="color:#8b5cf6; margin-bottom:0.5rem; width:28px; height:28px;"></i>
        <h3 style="font-size:1.1rem; margin-bottom:0.25rem;">Zoho Analytics & Zia Intelligence</h3>
        <p style="font-size:0.8rem; color:var(--text-muted);">Bilingual Chat (EN/KN), Socio-Demographic Correlation & PDF Export</p>
      </div>
    </div>
  </div>

  <!-- Performance & Cost Footnote -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.85rem;" class="muted">
    <div>
      <strong style="color: var(--text);">⚡ Performance Metrics:</strong>
      <br>Average Page Load: &lt;450ms | MO Check Latency: &lt;35ms | Memory Usage: ~42MB
    </div>
    <div>
      <strong style="color: var(--text);">💰 Infrastructure Estimation:</strong>
      <br>State-wide Karnataka Rollout: ~₹2,500/month (Leveraging Zoho Catalyst Serverless)
    </div>
  </div>
</div>

