<%- include('partials/head', { page: 'chat', title: 'Zia Assistant' }) %>
<%- include('partials/nav', { role: role || 'investigator', page }) %>

<div class="chat-container">
  <div class="chat-header">
    <div>
      <h1>Zia Assistant</h1>
    <span class="zoho-label"><i data-lucide="bot"></i> Zia Assistant — on-platform AI</span>
    </div>
  </div>

  <div class="quick-questions">
    <button onclick="askQuestion('Show chain-snatching cases in Mysuru this month')">
      <span class="en">Chain snatching in Mysuru</span>
      <span class="kn">ಮೈಸೂರಿನಲ್ಲಿ ಸರಪಳಿ ಕಳ್ಳತನ</span>
    </button>
    <button onclick="askQuestion('Which accused have the highest risk score?')">
      <span class="en">Highest risk accused</span>
      <span class="kn">ಅತಿ ಹೆಚ್ಚು ಅಪಾಯಕಾರಿ ಆರೋಪಿಗಳು</span>
    </button>
    <button onclick="askQuestion('Any repeat MOs this week?')">
      <span class="en">Repeat MOs this week</span>
      <span class="kn">ಈ ವಾರ ಪುನರಾವರ್ತಿತ MOಗಳು</span>
    </button>
    <button onclick="askQuestion('Burglary hotspots in Bengaluru')">
      <span class="en">Burglary hotspots</span>
      <span class="kn">ಕಳ್ಳತನದ ಹಾಟ್‌ಸ್ಪಾಟ್‌ಗಳು</span>
    </button>
    <button onclick="askQuestion('Cybercrime trends')">
      <span class="en">Cybercrime trends</span>
      <span class="kn">ಸೈಬರ್ ಕ್ರೈಮ್ ಪ್ರವೃತ್ತಿಗಳು</span>
    </button>
  </div>

  <div id="chat-messages" class="chat-messages"></div>

  <div class="chat-input-bar">
    <input type="text" id="chat-input" placeholder="Ask Zia about cases, accused, patterns..." onkeydown="if(event.key==='Enter')sendMessage()">
    <button class="btn-primary" onclick="sendMessage()">Send</button>
  </div>
</div>

<%- include('partials/footer', { extraScripts: '<script src="/js/chat.js"></script><script src="/js/chat-nudge.js"></script>' }) %>
