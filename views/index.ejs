<%- include('partials/head', { page: 'home' }) %>

<div class="landing-hero">
  <div class="glow-orb top-left"></div>
  <div class="glow-orb bottom-right"></div>
  
  <div class="landing-content">
    <div class="brand-showcase">
      <div class="shield-icon">
        <i data-lucide="shield-half"></i>
      </div>
      <h1 class="landing-title">
        <span class="en">Sujaga</span>
        <span class="divider">|</span>
        <span class="kn">ಸುಜಾಗ</span>
      </h1>
      <p class="tagline">Advanced Crime Intelligence Platform</p>
      
      <div class="auth-badge">
        <i data-lucide="lock"></i>
        <span>Zoho Directory Secure Access</span>
      </div>
    </div>

    <div class="role-selector">
      <h2 class="role-heading">Select Authentication Level</h2>
      
      <div class="terminal-grid">
        <a href="/fir/entry" class="terminal-card">
          <div class="card-glow"></div>
          <div class="icon-wrapper data">
            <i data-lucide="file-signature"></i>
          </div>
          <div class="card-content">
            <h3>Data Entry</h3>
            <p>
              <span class="en">Register FIRs securely. Live MO matching engine triggers on submission.</span>
              <span class="kn">ಎಫ್‌ಐಆರ್ ನಮೂದಿಸಿ. ಲೈವ್ MO ಹೊಂದಾಣಿಕೆ ತಕ್ಷಣ ಪ್ರಚೋದಿಸುತ್ತದೆ.</span>
            </p>
          </div>
          <div class="card-action">
            <span>Initialize</span> <i data-lucide="arrow-right"></i>
          </div>
        </a>

        <a href="/chat" class="terminal-card">
          <div class="card-glow"></div>
          <div class="icon-wrapper investigator">
            <i data-lucide="search"></i>
          </div>
          <div class="card-content">
            <h3>Investigator</h3>
            <p>
              <span class="en">Query intel with Zia Assistant. Extract criminal networks & evidence trails.</span>
              <span class="kn">ಜಿಯಾ ಸಹಾಯಕನೊಂದಿಗೆ ಇಂಟೆಲ್ ಪ್ರಶ್ನಿಸಿ. ಅಪರಾಧ ಜಾಲಗಳನ್ನು ಹೊರತೆಗೆಯಿರಿ.</span>
            </p>
          </div>
          <div class="card-action">
            <span>Initialize</span> <i data-lucide="arrow-right"></i>
          </div>
        </a>

        <a href="/dashboard?role=supervisor" class="terminal-card featured">
          <div class="card-glow"></div>
          <div class="icon-wrapper supervisor">
            <i data-lucide="satellite"></i>
          </div>
          <div class="card-content">
            <h3>Supervisor Command</h3>
            <p>
              <span class="en">Real-time analytics, dynamic risk scoreboards, and geographic hotspot intelligence.</span>
              <span class="kn">ರಿಯಲ್-ಟೈಮ್ ಅನಾಲಿಟಿಕ್ಸ್ ಮತ್ತು ಪ್ರಾದೇಶಿಕ ಹಾಟ್‌ಸ್ಪಾಟ್ ಇಂಟೆಲಿಜೆನ್ಸ್.</span>
            </p>
          </div>
          <div class="card-action">
            <span>Initialize</span> <i data-lucide="arrow-right"></i>
          </div>
        </a>
      </div>
    </div>
  </div>
  
  <div class="landing-footer-note">
    <p>⚡ Powered by Zoho Ecosystem · KSP Intelligence Prototype</p>
  </div>
</div>

<%- include('partials/footer') %>
