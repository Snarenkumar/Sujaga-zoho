<%- include('partials/head', { page: 'dashboard', title: 'Supervisor Dashboard' }) %>
<%- include('partials/nav', { role, page }) %>

<div class="page-header">
  <div>
    <h1>
      <span class="en">Supervisor Command Center</span>
      <span class="kn">ಮೇಲ್ವಿಚಾರಕ ಕಮಾಂಡ್ ಸೆಂಟರ್</span>
    </h1>
    <span class="zoho-label"><i data-lucide="bar-chart-3"></i> Zoho Analytics</span>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <span class="stat-label"><span class="en">Total FIRs</span><span class="kn">ಒಟ್ಟು ಎಫ್‌ಐಆರ್‌ಗಳು</span></span>
    <span class="stat-value"><%= stats.totalFirs %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label"><span class="en">Open Cases</span><span class="kn">ತೆರೆದ ಪ್ರಕರಣಗಳು</span></span>
    <span class="stat-value amber"><%= stats.openCases %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label"><span class="en">High-Risk Offenders</span><span class="kn">ಅಧಿಕ ಅಪಾಯದ ಅಪರಾಧಿಗಳು</span></span>
    <span class="stat-value red"><%= stats.highRiskOffenders %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label"><span class="en">Cross-District Matches</span><span class="kn">ಜಿಲ್ಲಾಂತರ ಹೊಂದಾಣಿಕೆಗಳು</span></span>
    <span class="stat-value blue"><%= stats.crossDistrictMatches %></span>
  </div>
</div>

<div class="chart-grid">
  <div class="panel">
    <h3><span class="en">Crimes by Type</span><span class="kn">ಪ್ರಕಾರದಿಂದ ಅಪರಾಧಗಳು</span></h3>
    <canvas id="chart-type"></canvas>
  </div>
  <div class="panel">
    <h3><span class="en">Crimes by District</span><span class="kn">ಜಿಲ್ಲೆಯಿಂದ ಅಪರಾಧಗಳು</span></h3>
    <canvas id="chart-district"></canvas>
  </div>
  <div class="panel wide">
    <h3><span class="en">Monthly Trend</span><span class="kn">ಮಾಸಿಕ ಪ್ರವೃತ್ತಿ</span></h3>
    <canvas id="chart-trend"></canvas>
  </div>
</div>

<div class="panel" style="margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
    <h3><span class="en">Socio-Demographic Crime Correlation</span><span class="kn">ಸಾಮಾಜಿಕ-ಜನಸಂಖ್ಯಾ ಅಪರಾಧ ಪರಸ್ಪರ ಸಂಬಂಧ</span></h3>
    <span class="zoho-label"><i data-lucide="line-chart"></i> Zoho Analytics Insights</span>
  </div>
  <div style="position: relative; width: 100%; height: 320px;">
    <canvas id="chart-socio"></canvas>
  </div>
  <p class="muted" style="margin-top: 12px; font-size: 13px; font-style: italic; color: #94a3b8;">
    <span class="en">Correlating crime density with socio-economic indicators to identify root-cause risk factors, not just incident counts.</span>
    <span class="kn">ಅಪರಾಧ ಸಾಂದ್ರತೆ ಮತ್ತು ಸಾಮಾಜಿಕ-ಆರ್ಥಿಕ ಸೂಚಕಗಳನ್ನು ಪರಸ್ಪರ ಸಂಬಂಧಿಸಿ ಮೂಲ ಅಪಾಯ ಅಂಶಗಳನ್ನು ಗುರುತಿಸಲು.</span>
  </p>
</div>

<div class="panel">
  <h3><span class="en">Risk Scoreboard</span><span class="kn">ಅಪಾಯ ಸ್ಕೋರ್‌ಬೋರ್ಡ್</span></h3>
  <div class="table-wrap">
    <table class="data-table" id="risk-table">
      <thead>
        <tr>
          <th data-sort="name"><span class="en">Accused Name</span><span class="kn">ಆರೋಪಿ ಹೆಸರು</span></th>
          <th data-sort="district"><span class="en">District</span><span class="kn">ಜಿಲ್ಲೆ</span></th>
          <th data-sort="risk"><span class="en">Risk Score</span><span class="kn">ಅಪಾಯ ಸ್ಕೋರ್</span></th>
          <th data-sort="associates"><span class="en">Known Associates</span><span class="kn">ಪರಿಚಿತ ಸಹಚರರು</span></th>
          <th><span class="en">Linked FIRs</span><span class="kn">ಸಂಬಂಧಿತ ಎಫ್‌ಐಆರ್‌ಗಳು</span></th>
        </tr>
      </thead>
      <tbody>
        <% accusedSorted.forEach(a => {
          const level = a.risk_score >= 80 ? 'high' : a.risk_score >= 60 ? 'med' : 'low';
        %>
        <tr>
          <td><strong><%= a.name %></strong><br><small class="muted"><%= a.alias %></small></td>
          <td><%= a.district %></td>
          <td><span class="badge badge-<%= level %>"><%= a.risk_score %></span></td>
          <td><%= a.known_associate_ids.length %></td>
          <td><%= a.linked_fir_ids.length %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer', { extraScripts: `
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  const crimesByType = ${JSON.stringify(crimesByType)};
  const crimesByDistrict = ${JSON.stringify(crimesByDistrict)};
  const monthlyTrend = ${JSON.stringify(monthlyTrend)};

  const chartOpts = {
    responsive: true,
    plugins: { 
      legend: { labels: { color: '#94a3b8', font: { family: "'Plus Jakarta Sans', sans-serif" } } },
      tooltip: { 
        backgroundColor: 'rgba(16, 22, 35, 0.9)', 
        titleColor: '#F8FAFC', 
        bodyColor: '#94a3b8',
        borderColor: 'rgba(255,255,255,0.1)',
        borderWidth: 1,
        padding: 10
      }
    },
    scales: {
      x: { ticks: { color: '#94a3b8', font: { family: "'Plus Jakarta Sans', sans-serif" } }, grid: { color: 'rgba(255,255,255,0.03)', drawBorder: false } },
      y: { ticks: { color: '#94a3b8', font: { family: "'Plus Jakarta Sans', sans-serif" } }, grid: { color: 'rgba(255,255,255,0.03)', drawBorder: false } }
    }
  };

  const ctxTrend = document.getElementById('chart-trend').getContext('2d');
  const gradientBlue = ctxTrend.createLinearGradient(0, 0, 0, 400);
  gradientBlue.addColorStop(0, 'rgba(56, 189, 248, 0.4)');
  gradientBlue.addColorStop(1, 'rgba(56, 189, 248, 0.01)');

  const ctxType = document.getElementById('chart-type').getContext('2d');
  const gradientRose = ctxType.createLinearGradient(0, 0, 0, 400);
  gradientRose.addColorStop(0, '#F43F5E');
  gradientRose.addColorStop(1, 'rgba(244, 63, 94, 0.2)');

  new Chart(document.getElementById('chart-type'), {
    type: 'bar',
    data: {
      labels: Object.keys(crimesByType),
      datasets: [{ label: 'Cases', data: Object.values(crimesByType), backgroundColor: gradientRose, borderRadius: 4 }]
    },
    options: chartOpts
  });

  new Chart(document.getElementById('chart-district'), {
    type: 'bar',
    data: {
      labels: Object.keys(crimesByDistrict),
      datasets: [{ label: 'Cases', data: Object.values(crimesByDistrict), backgroundColor: '#38BDF8', borderRadius: 4 }]
    },
    options: { ...chartOpts, indexAxis: 'y' }
  });

  new Chart(document.getElementById('chart-trend'), {
    type: 'line',
    data: {
      labels: Object.keys(monthlyTrend).sort(),
      datasets: [{ 
        label: 'FIRs', 
        data: Object.keys(monthlyTrend).sort().map(k => monthlyTrend[k]), 
        borderColor: '#38BDF8', 
        backgroundColor: gradientBlue, 
        fill: true, 
        tension: 0.4,
        borderWidth: 2,
        pointBackgroundColor: '#060913',
        pointBorderColor: '#38BDF8',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6
      }]
    },
    options: chartOpts
  });

  fetch('/api/socio-demographic')
    .then(res => res.json())
    .then(data => {
      const districts = data.map(d => d.district);
      const crimeRates = data.map(d => d.crime_rate_index);
      const unemployment = data.map(d => d.unemployment_pct * 10); // scale up for comparative visual clarity
      const urbanization = data.map(d => d.urbanization_pct);
      const migration = data.map(d => d.migration_index);

      new Chart(document.getElementById('chart-socio'), {
        type: 'bar',
        data: {
          labels: districts,
          datasets: [
            { label: 'Crime Rate Index', data: crimeRates, backgroundColor: '#F43F5E', borderRadius: 4 },
            { label: 'Urbanization %', data: urbanization, backgroundColor: '#38BDF8', borderRadius: 4 },
            { label: 'Migration Index', data: migration, backgroundColor: '#A855F7', borderRadius: 4 },
            { label: 'Unemployment (x10 %)', data: unemployment, backgroundColor: '#F59E0B', borderRadius: 4 }
          ]
        },
        options: {
          ...chartOpts,
          maintainAspectRatio: false
        }
      });
    });

  document.querySelectorAll('#risk-table th[data-sort]').forEach(th => {
    th.style.cursor = 'pointer';
    th.addEventListener('click', () => {
      const key = th.dataset.sort;
      const tbody = document.querySelector('#risk-table tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const idx = { name: 0, district: 1, risk: 2, associates: 3 }[key];
      rows.sort((a, b) => {
        let av = a.children[idx].innerText, bv = b.children[idx].innerText;
        if (key === 'risk' || key === 'associates') return parseInt(bv) - parseInt(av);
        return av.localeCompare(bv);
      });
      rows.forEach(r => tbody.appendChild(r));
    });
  });
</script>
` }) %>
