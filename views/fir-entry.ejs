<%- include('partials/head', { page: 'fir-entry', title: 'FIR Data Entry' }) %>
<%- include('partials/nav', { role, page }) %>

<div class="creator-header">
  <span class="zoho-label"><i data-lucide="layers"></i> Powered by Zoho Creator</span>
  <span class="creator-title">FIR Registration Form</span>
</div>

<% if (success) { %>
<div class="toast success" id="sync-toast">
  ✓ <%= success %> 
  <span class="zoho-flow-label" style="margin-left: 8px;"><i data-lucide="zap"></i> Zoho Flow</span>
  <span class="zoho-flow-label" style="margin-left: 4px; background: rgba(34, 197, 94, 0.15); color: #4ade80; border-color: rgba(34, 197, 94, 0.3);"><i data-lucide="file-spreadsheet"></i> Zoho Sheet</span>
</div>
<% } %>

<% if (match) { %>
<div class="alert-banner match-alert">
  ⚠ This MO matches <strong>FIR <%= match.otherFirNo %></strong> filed in <%= match.otherDistrict %>, <%= match.daysAgo %> days ago
  (<strong><%= match.similarity %>% match</strong>) —
  <button class="link-btn" onclick="openEvidenceModal('<%= match.matchId %>')">view evidence trail</button>
</div>
<% } %>

<div class="panel form-panel">
  <!-- Interactive Demo Quick Fill Banner -->
  <div style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 10px; padding: 1rem; margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.5rem;">
      <span style="font-weight: 600; font-size: 0.9rem; color: #38BDF8; display: flex; align-items: center; gap: 6px;">
        <i data-lucide="sparkles"></i> Live Demo Presets (One-Click Auto-Fill)
      </span>
      <span style="font-size: 0.8rem; color: #94a3b8;">Click any preset to pre-fill the form & trigger live MO matching + Zoho Sheet write</span>
    </div>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <button type="button" class="btn-secondary" onclick="fillDemoPreset('chain')" style="font-size: 0.8rem; padding: 6px 12px; cursor: pointer;">
        🏍️ Chain Snatching (Trigger Live Alert)
      </button>
      <button type="button" class="btn-secondary" onclick="fillDemoPreset('burglary')" style="font-size: 0.8rem; padding: 6px 12px; cursor: pointer;">
        🏠 Burglary MO Match
      </button>
      <button type="button" class="btn-secondary" onclick="fillDemoPreset('theft')" style="font-size: 0.8rem; padding: 6px 12px; cursor: pointer;">
        🛵 Two-Wheeler Theft
      </button>
    </div>
  </div>

  <form id="fir-form" action="/fir/entry" method="POST">
    <div class="form-grid">
      <div class="form-group">
        <label>FIR No</label>
        <input type="text" id="input_fir_no" name="fir_no" placeholder="BLR/2025/040" required>
      </div>
      <div class="form-group">
        <label>Date / Time</label>
        <input type="datetime-local" id="input_date_time" name="date_time" required>
      </div>
      <div class="form-group">
        <label>District</label>
        <select id="input_district" name="district" required>
          <option value="">Select district</option>
          <option>Bengaluru Urban</option>
          <option>Mysuru</option>
          <option>Mangaluru</option>
          <option>Hubballi-Dharwad</option>
          <option>Belagavi</option>
        </select>
      </div>
      <div class="form-group">
        <label>Police Station</label>
        <input type="text" id="input_police_station" name="police_station" placeholder="Koramangala PS" required>
      </div>
      <div class="form-group">
        <label>IPC Sections</label>
        <input type="text" id="input_ipc_sections" name="ipc_sections" placeholder="379, 392" required>
      </div>
      <div class="form-group">
        <label>Crime Type</label>
        <select id="input_crime_type" name="crime_type" required>
          <option value="">Select type</option>
          <option>Chain Snatching</option>
          <option>Two-Wheeler Theft</option>
          <option>Burglary</option>
          <option>Cybercrime</option>
        </select>
      </div>
      <div class="form-group full">
        <label>GPS / Location</label>
        <input type="text" id="input_location_text" name="location_text" placeholder="Street address or landmark" required>
      </div>
      <div class="form-group full">
        <label>MO Description <span class="hint">(Try: "chain snatch on black Pulsar two-wheeler" for live demo match)</span></label>
        <textarea id="input_mo_description" name="mo_description" rows="4" placeholder="Describe modus operandi in detail..." required></textarea>
      </div>
      <div class="form-group">
        <label>Accused Name(s)</label>
        <input type="text" id="input_accused_names" name="accused_names" placeholder="Comma-separated">
      </div>
      <div class="form-group">
        <label>Victim Name(s)</label>
        <input type="text" id="input_victim_names" name="victim_names" placeholder="Comma-separated">
      </div>
    </div>
    <button type="submit" class="btn-primary">Submit FIR → Run Live Sync & MO Match</button>
  </form>
</div>

<%- include('partials/footer', { extraScripts: '<script src="/js/fir-entry.js"></script>' }) %>
